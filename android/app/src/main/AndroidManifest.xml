<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing and removing the apps Orbit lists. Android still asks you to confirm each one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ only shows an app another app's packages it names here. -->
    <queries>
        <package android:name="app.pocketfader.client" />
        <package android:name="app.novalabs.pocketfader" />
        <package android:name="app.novalabs.nova" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Orbit"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".InstallReceiver" android:exported="false" />
    </application>
</manifest>
